{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Browse",
  "version": "0.1.2",
  "identifier": "com.pleiades.browse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Browse",
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Browse"
      }
    },
    "shortDescription": "App installer with download queue and bundles",
    "longDescription": "Browse is a minimalist dark-mode installer with real package manager installs (winget, brew, flatpak, npm, pip), download queue, and curated multi-app bundles.",
    "category": "Utility",
    "copyright": "Copyright © Browse"
  }
}
